# Conductor secrets — copy to .env and fill in.
# .env is gitignored. .env.example IS committed (template).

# api.congress.gov (free key — https://api.congress.gov/sign-up/)
CONGRESS_GOV_API_KEY=

# Senate LDA — optional key raises anon rate limit. Register at
# https://lda.senate.gov/api/register/ (account-creation form).
LDA_API_KEY=

# OpenRouter (for LLM voice passes — render.py)
OPENROUTER_API_KEY=

# OpenFEC (campaign finance — free key at https://api.open.fec.gov/developers)
OPENFEC_API_KEY=

# Cloudflare edge cache — see CLOUDFLARE.md.
# Both must be set for the post-daily-update cache purge to fire; unset is a
# logged no-op, so local dev needs neither. Token needs exactly one permission:
# Zone → Cache Purge → Purge, scoped to the tallyhq.org zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# Optional cache tuning. Defaults: 86400 (1 day edge hold) / 604800 (7 day SWR).
# EDGE_TTL_SECONDS=0 disables edge caching without a code change.
# EDGE_TTL_SECONDS=
# EDGE_SWR_SECONDS=
